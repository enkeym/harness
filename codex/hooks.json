{
  "description": "Harness: background RAG sync",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.ai-hooks/bin/ragsave-sync.sh\" --warm \"$PWD\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.ai-hooks/bin/ragsave-sync.sh\" \"$PWD\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
