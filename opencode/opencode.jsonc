{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "read", "resource": "*.env*", "effect": "ask" }
  ],
  "providers": {
    "deepseek": {
      "name": "deepseek",
      "package": "@ai-sdk/openai",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{file:~/.config/opencode/keys/deepseek}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "modelID": "deepseek-v4-pro",
          "limit": { "input": 150000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.66,
            "output": 1.98,
            "cache": { "read": 0.022, "write": 0 }
          }
        },
        "deepseek-flash": {
          "name": "deepseek-flash",
          "modelID": "deepseek-flash",
          "limit": { "input": 150000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": { "read": 0.003, "write": 0 }
          }
        }
      }
    },
    "kimi-for-coding-oauth": {
      "settings": { "reasoningEffort": "low" }
    },
    "openai": {
      "settings": { "reasoningEffort": "low" }
    }
  },
  "model": "deepseek/deepseek-flash",
  "instructions": [],
  "commands": {},
  "agents": {
    "compaction": {
      "model": "deepseek/deepseek-flash#low"
    },
    "plan": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 30000
  },
  "experimental": {
    "background_compaction": false
  },
  "plugins": [],
  "mcp": {
    "servers": {
      "tokensave": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/korolev/.ai-hooks/bin/mcp-proxy.mjs",
          "--compact",
          "--",
          "bash",
          "/home/korolev/.ai-hooks/bin/mcp-serve.sh",
          "tokensave"
        ],
        "environment": {}
      },
      "ragsave": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/korolev/.ai-hooks/bin/mcp-proxy.mjs",
          "--",
          "bash",
          "/home/korolev/.ai-hooks/bin/mcp-serve.sh",
          "ragsave"
        ],
        "environment": {}
      },
      "playwright": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/korolev/.ai-hooks/bin/mcp-proxy.mjs",
          "--catalog",
          "/home/korolev/.config/harness/repo/mcp/playwright-tools.json",
          "--playwright-compat",
          "--",
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--extension",
          "--browser=chrome"
        ],
        "environment": {
          "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "{env:PLAYWRIGHT_MCP_EXECUTABLE_PATH}"
        }
      }
    }
  }
}
