{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "read", "resource": "*.env*", "effect": "ask" }
  ],
  "providers": {
    "deepseek": {
      "name": "deepseek",
      "package": "@ai-sdk/openai",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{file:~/.config/opencode/keys/deepseek}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "modelID": "deepseek-v4-pro",
          "limit": { "input": 120000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.66,
            "output": 1.98,
            "cache": { "read": 0.022, "write": 0 }
          }
        },
        "deepseek-flash": {
          "name": "deepseek-flash",
          "modelID": "deepseek-flash",
          "limit": { "input": 120000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": { "read": 0.003, "write": 0 }
          }
        }
      }
    },
    "openai": {
      "settings": { "reasoningEffort": "low" },
      "models": {
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "modelID": "gpt-6-sol",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "modelID": "gpt-6.1-sol",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        }
      }
    }
  },
  "model": "deepseek/deepseek-flash",
  "instructions": [],
  "commands": {},
  "agents": {
    "compaction": {
      "model": "deepseek/deepseek-flash#low"
    },
    "plan": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 25000
  },
  "experimental": {
    "background_compaction": false
  },
  "plugins": [
    "./plugins/harness/qwen-oauth",
    "opencode-kimi-v2",
    "./plugins/harness/kimi-tuning"
  ]
}
