  },
  "model": "{env:OPENCODE_DEFAULT_MODEL}",
  "instructions": [],
  "commands": {},
  "agents": {
    "compaction": {
      "model": "{env:OPENCODE_DEFAULT_MODEL}#low"
    },
    "plan": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 25000
  },
  "experimental": {
    "background_compaction": false
  },
  "plugins": [
    "./plugins/harness/qwen-oauth",
    "opencode-kimi-v2",
    "./plugins/harness/kimi-tuning",
    "./plugins/harness/opencode-go-tuning"
  ]
}
