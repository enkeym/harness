{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "read", "resource": "*.env*", "effect": "ask" }
  ],
  "providers": {
    "deepseek": {
      "name": "deepseek",
      "package": "@ai-sdk/openai",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{file:~/.config/opencode/keys/deepseek}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "modelID": "deepseek-v4-pro",
          "limit": { "input": 175000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.66,
            "output": 1.98,
            "cache": { "read": 0.022, "write": 0 }
          }
        },
        "deepseek-flash": {
          "name": "deepseek-flash",
          "modelID": "deepseek-flash",
          "limit": { "input": 175000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": { "api": "chat", "reasoningEffort": "low" },
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache": { "read": 0.003, "write": 0 }
          }
        }
      }
    },
    "kimi-for-coding-oauth": {
      "settings": { "reasoningEffort": "low" },
      "models": {
        "k3.1-pro-highspeed": { "disabled": true }
      }
    },
    "openai": {
      "settings": { "reasoningEffort": "low" },
      "models": {
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "modelID": "gpt-6-luna",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        },
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "modelID": "gpt-6-sol",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "modelID": "gpt-6.1-sol",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        },
        "gpt-6.1-terra": {
          "name": "gpt-6.1-terra",
          "modelID": "gpt-6.1-terra",
          "limit": { "input": 250000, "output": 8192 },
          "capabilities": {
            "reasoning": { "supported": true, "effort": ["low", "high"] }
          },
          "settings": {
            "reasoningEffort": "low",
            "body": {
              "reasoning": { "effort": "low", "summary": "auto" },
              "max_output_tokens": 8192
            }
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning": { "effort": "low", "summary": "auto" },
                "max_output_tokens": 8192
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high", "summary": "auto" },
                "max_output_tokens": 8192
              }
            }
          ]
        },
        "chat-latest": { "disabled": true },
        "gpt-4.1": { "disabled": true },
        "gpt-4.1-fast": { "disabled": true },
        "gpt-4.1-mini": { "disabled": true },
        "gpt-4.1-mini-fast": { "disabled": true },
        "gpt-4o": { "disabled": true },
        "gpt-4o-2024-08-06": { "disabled": true },
        "gpt-4o-2024-11-20": { "disabled": true },
        "gpt-4o-fast": { "disabled": true },
        "gpt-4o-mini": { "disabled": true },
        "gpt-4o-mini-fast": { "disabled": true },
        "gpt-5": { "disabled": true },
