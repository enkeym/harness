{
  "$schema": "https://opencode.ai/config.json",
  "theme": "dracula",
  "model": "opencode/space-bunny-free",
  "providers": {
    "opencode": {
      "models": {
        "exo-free": { "disabled": true },
        "ling-3.0-flash-fin-free": { "disabled": true },
        "ling-3.1-flash-free": { "disabled": true },
        "mimo-v2.6-flash-free": { "disabled": true },
        "nemotron-3-ultra-free": { "disabled": true },
        "cat-jam-free": { "disabled": true }
      }
    },
    "anthropic": {
      "models": {
        "claude-fable-5-1": { "disabled": true },
        "claude-haiku-4-5-20251001": { "disabled": true },
        "claude-opus-4-5-20251101": { "disabled": true },
        "claude-sonnet-4-5-20250929": { "disabled": true }
      }
    },
    "zai-coding-plan": {
      "models": {
        "glm-5.2-highspeed": { "disabled": true },
        "glm-5.3-highspeed": { "disabled": true }
      }
    }
  },
  "disabled_providers": ["google", "gitlab"],
  "mcp": {
    "tokensave": {
      "type": "local",
      "command": [
        "{env:HOME}/.ai-hooks/bin/mcp-serve.sh",
        "tokensave"
      ]
    },
    "ragsave": {
      "type": "local",
      "command": [
        "{env:HOME}/.ai-hooks/bin/mcp-serve.sh",
        "ragsave"
      ]
    }
  },
  "permission": {
    "edit": "ask",
    "write": "ask",
    "external_directory": "allow",
    "skill": {
      "*": "allow",
      "commit": "deny",
      "doctor": "deny",
      "optimize": "deny",
      "usage": "deny",
      "hooks-guards": "deny",
      "impact-map": "ask",
      "review": "ask",
      "test-browser": "ask"
    },
    "task": {
      "*": "deny",
      "commit": "allow"
    },
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git -* commit*": "ask",
      "git -* push*": "ask",
      "git am*": "ask",
      "git -* am *": "ask",
      "git merge*": "ask",
      "git -* merge *": "ask",
      "git *--continue*": "ask",
      "env": "ask",
      "printenv*": "ask",
      "dotenv*printenv*": "ask",
      "set": "ask",
      "export": "ask",
      "export -*": "ask",
      "declare": "ask",
      "declare -*": "ask",
      "typeset": "ask",
      "typeset -*": "ask",
      "*jq *env*": "ask",
      "*jq *$ENV*": "ask",
      "docker compose*config*": "ask",
      "docker-compose*config*": "ask",
      "pg_dump*": "ask",
      "mysqldump*": "ask",
      "mongodump*": "ask",
      "pgbackrest*": "ask",
      "psql* -h*": "ask",
      "psql* --host*": "ask",
      "psql*://*": "ask",
      "psql*COPY*": "ask",
      "psql*host=*": "ask",
      "*PGHOST=*": "ask",
      "*MYSQL_HOST=*": "ask",
      "mysql* -h*": "ask",
      "mysql* --host*": "ask",
      "mongosh*": "ask",
      "mongo *": "ask",
      "redis-cli*": "ask",
      "clickhouse-client*": "ask",
      "sqlite3*.dump*": "ask",
      "docker*prod*": "ask",
      "kubectl*apply*": "ask",
      "kubectl*delete*": "ask",
      "kubectl*scale*": "ask",
      "kubectl*rollout*": "ask",
      "kubectl*patch*": "ask",
      "ssh*systemctl*": "ask",
      "ssh*docker*": "ask",
      "ssh* rm *": "ask",
      "ssh*deploy*": "ask",
      "ssh*migrate*": "ask",
      "curl* -d*": "ask",
      "curl* --data*": "ask",
      "curl* -F*": "ask",
      "curl* --form*": "ask",
      "curl* -T*": "ask",
      "curl* --upload-file*": "ask",
      "curl* --json*": "ask",
      "wget* --post-*": "ask",
      "wget* --body-*": "ask",
      "tokensave *install*": "deny"
    },
    "tokensave_tokensave_*": "deny",
    "tokensave_tokensave_read": "allow",
    "tokensave_tokensave_body": "allow",
    "tokensave_tokensave_signature": "allow",
    "tokensave_tokensave_context": "allow",
    "tokensave_tokensave_search": "allow",
    "tokensave_tokensave_files": "allow",
    "tokensave_tokensave_callers": "allow",
    "tokensave_tokensave_callees": "allow",
    "tokensave_tokensave_impact": "allow",
    "tokensave_tokensave_affected": "allow",
    "tokensave_tokensave_similar": "allow",
    "tokensave_tokensave_blame": "allow",
    "tokensave_tokensave_str_replace": "allow",
    "tokensave_tokensave_multi_str_replace": "allow",
    "tokensave_tokensave_replace_symbol": "allow",
    "tokensave_tokensave_insert_at": "allow",
    "tokensave_tokensave_insert_at_symbol": "allow",
    "tokensave_tokensave_status": "allow",
    "tokensave_tokensave_more": "allow",
    "tokensave_tokensave_session_recall": "allow",
    "tokensave_tokensave_record_decision": "allow"
  },
  "agent": {
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "instructions": [
    "~/.config/opencode/rules/core.md"
  ],
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.4"
  ]
}
