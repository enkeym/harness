{
  "$schema": "https://opencode.ai/config.json",
  "theme": "vscode-dark-plus",
  "default_agent": "ask",
  "mcp": {
    "tokensave": {
      "type": "local",
      "command": [
        "/home/enkeym/.ai-hooks/bin/mcp-serve.sh",
        "tokensave"
      ]
    },
    "ragsave": {
      "type": "local",
      "command": [
        "/home/enkeym/.ai-hooks/bin/mcp-serve.sh",
        "ragsave"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ]
    }
  },
  "permission": {
    "edit": "ask",
    "write": "ask",
    "skill": {
      "*": "allow",
      "commit": "deny",
      "doctor": "deny",
      "optimize": "deny",
      "usage": "deny",
      "hooks-guards": "deny"
    },
    "task": "deny",
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask"
    }
  },
  "agent": {
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "instructions": [
    "/home/enkeym/.config/opencode/rules/core.md",
    "/home/enkeym/.config/opencode/tokensave.md"
  ],
  "plugin": [
    "@ex-machina/opencode-anthropic-auth@1.8.4"
  ]
}
