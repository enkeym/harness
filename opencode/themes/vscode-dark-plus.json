{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1e1e1e",
    "bgPanel": "#252526",
    "bgElement": "#2d2d30",
    "bgInput": "#3c3c3c",
    "fg": "#d4d4d4",
    "fgMuted": "#858585",
    "border": "#2d2d30",
    "borderActive": "#454545",
    "vscodeBlue": "#007acc",
    "linkBlue": "#3794ff",
    "listBlue": "#6796e6",
    "kwBlue": "#569cd6",
    "kwPurple": "#c586c0",
    "typeTeal": "#4ec9b0",
    "varBlue": "#9cdcfe",
    "strSalmon": "#ce9178",
    "numGreen": "#b5cea8",
    "commentGreen": "#6a9955",
    "red": "#f48771",
    "orange": "#cca700",
    "diffAddFg": "#81b88b",
    "diffDelFg": "#c74e39",
    "diffAddHi": "#9ccc2c",
    "diffDelHi": "#f14c4c",
    "diffAddBg": "#373d29",
    "diffDelBg": "#4b1818",
    "diffAddNumBg": "#2c3421",
    "diffDelNumBg": "#3a1a1a"
  },
  "theme": {
    "primary": { "dark": "vscodeBlue", "light": "#005fb8" },
    "secondary": { "dark": "kwBlue", "light": "#0000ff" },
    "accent": { "dark": "vscodeBlue", "light": "#005fb8" },
    "text": { "dark": "fg", "light": "#000000" },
    "textMuted": { "dark": "fgMuted", "light": "#6c6c6c" },
    "background": { "dark": "bg", "light": "#ffffff" },
    "backgroundPanel": { "dark": "bgPanel", "light": "#f3f3f3" },
    "backgroundElement": { "dark": "bgElement", "light": "#ececec" },
    "border": { "dark": "border", "light": "#e5e5e5" },
    "borderActive": { "dark": "borderActive", "light": "#cecece" },
    "borderSubtle": { "dark": "border", "light": "#f0f0f0" },
    "error": { "dark": "red", "light": "#e51400" },
    "warning": { "dark": "orange", "light": "#bf8803" },
    "success": { "dark": "commentGreen", "light": "#008000" },
    "info": { "dark": "kwBlue", "light": "#005fb8" },

    "diffAdded": { "dark": "diffAddFg", "light": "#587c0c" },
    "diffRemoved": { "dark": "diffDelFg", "light": "#ad0707" },
    "diffContext": { "dark": "fgMuted", "light": "#6c6c6c" },
    "diffHunkHeader": { "dark": "fgMuted", "light": "#6c6c6c" },
    "diffHighlightAdded": { "dark": "diffAddHi", "light": "#587c0c" },
    "diffHighlightRemoved": { "dark": "diffDelHi", "light": "#ad0707" },
    "diffAddedBg": { "dark": "diffAddBg", "light": "#e6f0d4" },
    "diffRemovedBg": { "dark": "diffDelBg", "light": "#fbdada" },
    "diffContextBg": { "dark": "bg", "light": "#ffffff" },
    "diffLineNumber": { "dark": "fgMuted", "light": "#6e7681" },
    "diffAddedLineNumberBg": { "dark": "diffAddNumBg", "light": "#d8e8c0" },
    "diffRemovedLineNumberBg": { "dark": "diffDelNumBg", "light": "#f5c6c6" },

    "markdownText": { "dark": "fg", "light": "#000000" },
    "markdownHeading": { "dark": "kwBlue", "light": "#800000" },
    "markdownLink": { "dark": "linkBlue", "light": "#006ab1" },
    "markdownLinkText": { "dark": "linkBlue", "light": "#006ab1" },
    "markdownCode": { "dark": "strSalmon", "light": "#800000" },
    "markdownBlockQuote": { "dark": "commentGreen", "light": "#0451a5" },
    "markdownEmph": { "dark": "fg", "light": "#000000" },
    "markdownStrong": { "dark": "kwBlue", "light": "#000080" },
    "markdownHorizontalRule": { "dark": "fgMuted", "light": "#6c6c6c" },
    "markdownListItem": { "dark": "listBlue", "light": "#0451a5" },
    "markdownListEnumeration": { "dark": "listBlue", "light": "#0451a5" },
    "markdownImage": { "dark": "linkBlue", "light": "#006ab1" },
    "markdownImageText": { "dark": "strSalmon", "light": "#a31515" },
    "markdownCodeBlock": { "dark": "fg", "light": "#000000" },

    "syntaxKeyword": { "dark": "kwPurple", "light": "#af00db" },
    "syntaxFunction": { "dark": "varBlue", "light": "#001080" },
    "syntaxType": { "dark": "typeTeal", "light": "#267f99" },
    "syntaxString": { "dark": "strSalmon", "light": "#a31515" },
    "syntaxNumber": { "dark": "numGreen", "light": "#098658" },
    "syntaxComment": { "dark": "commentGreen", "light": "#008000" },
    "syntaxVariable": { "dark": "varBlue", "light": "#001080" },
    "syntaxOperator": { "dark": "fg", "light": "#000000" },
    "syntaxPunctuation": { "dark": "fg", "light": "#000000" }
  }
}
