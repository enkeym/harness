{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#1e1e1e",
    "bgPanel": "#252526",
    "bgElement": "#2d2d30",
    "bgInput": "#3c3c3c",
    "fg": "#d4d4d4",
    "fgMuted": "#858585",
    "border": "#2d2d30",
    "borderActive": "#454545",
    "vscodeBlue": "#007acc",
    "kwBlue": "#569cd6",
    "fnYellow": "#dcdcaa",
    "typeTeal": "#4ec9b0",
    "varBlue": "#9cdcfe",
    "strSalmon": "#ce9178",
    "numGreen": "#b5cea8",
    "commentGreen": "#6a9955",
    "red": "#f48771",
    "orange": "#cca700"
  },
  "theme": {
    "primary": { "dark": "vscodeBlue", "light": "#005fb8" },
    "secondary": { "dark": "kwBlue", "light": "#0000ff" },
    "accent": { "dark": "vscodeBlue", "light": "#005fb8" },
    "text": { "dark": "fg", "light": "#000000" },
    "textMuted": { "dark": "fgMuted", "light": "#6c6c6c" },
    "background": { "dark": "bg", "light": "#ffffff" },
    "backgroundPanel": { "dark": "bgPanel", "light": "#f3f3f3" },
    "backgroundElement": { "dark": "bgElement", "light": "#ececec" },
    "border": { "dark": "border", "light": "#e5e5e5" },
    "borderActive": { "dark": "borderActive", "light": "#cecece" },
    "borderSubtle": { "dark": "border", "light": "#f0f0f0" },
    "error": { "dark": "red", "light": "#e51400" },
    "warning": { "dark": "orange", "light": "#bf8803" },
    "success": { "dark": "commentGreen", "light": "#008000" },
    "info": { "dark": "kwBlue", "light": "#005fb8" },

    "syntaxKeyword": { "dark": "kwBlue", "light": "#0000ff" },
    "syntaxFunction": { "dark": "fnYellow", "light": "#795e26" },
    "syntaxType": { "dark": "typeTeal", "light": "#267f99" },
    "syntaxString": { "dark": "strSalmon", "light": "#a31515" },
    "syntaxNumber": { "dark": "numGreen", "light": "#098658" },
    "syntaxComment": { "dark": "commentGreen", "light": "#008000" },
    "syntaxVariable": { "dark": "varBlue", "light": "#001080" },
    "syntaxOperator": { "dark": "fg", "light": "#000000" },
    "syntaxPunctuation": { "dark": "fg", "light": "#000000" },

    "markdownText": { "dark": "varBlue", "light": "#001080" },
    "markdownCode": { "dark": "fnYellow", "light": "#795e26" },
    "markdownCodeBlock": { "dark": "varBlue", "light": "#001080" }
  }
}
