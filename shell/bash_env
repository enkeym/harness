# Подключается через BASH_ENV (см. ~/.bashrc): bash сам читает этот файл для
# неинтерактивных шеллов (в т.ч. Bash-тул харнесса), минуя ранний return в
# .bashrc, который иначе съедал бы этот блок целиком.

# Токен GitLab для агента: тот же, что уже лежит в ~/.git-credentials, второй
# копии секрета не заводим. Агенту нужен MR через API, а читать credentials ему
# запрещено (security-guard: содержимое файла осталось бы в транскрипте) — он
# пользуется переменной, не заглядывая внутрь. Хост — GITLAB_HOST из
# ~/.config/harness/env. Хоста, файла или строки для него нет — переменная
# выйдет пустой, и агент просто отдаст описание в чат.
[ -f "$HOME/.config/harness/env" ] && . "$HOME/.config/harness/env"
GITLAB_TOKEN=
if [ -n "${GITLAB_HOST:-}" ]; then
  GITLAB_TOKEN=$(grep -F "@$GITLAB_HOST" ~/.git-credentials 2>/dev/null | sed -n 's|https://[^:]*:\([^@]*\)@.*|\1|p' | head -1)
fi
export GITLAB_TOKEN
