# zsh читает ~/.zshenv каждым шеллом, интерактивным и нет — аналог BASH_ENV
# для bash. Нужен там, где $SHELL — zsh (macOS по умолчанию): Bash-тул Claude
# Code идёт через $SHELL, и без этого файла GITLAB_TOKEN и значения машины из
# ~/.config/harness/env ему не видны. Приглашение, плагины, nvm — дело своего
# ~/.zshrc, здесь только окружение.

# Homebrew на Apple Silicon: его установщик пишет `brew shellenv` в ~/.zprofile,
# а тот читают только login-шеллы — запуск из GUI или IDE без него не видит
# brew'шного python и tokensave.
if [ -x /opt/homebrew/bin/brew ]; then
  case ":$PATH:" in
    *":/opt/homebrew/bin:"*) ;;
    *) eval "$(/opt/homebrew/bin/brew shellenv)" ;;
  esac
fi

# ~/.local/bin — там лежит ragsave, как и в shell/bashrc.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# GITLAB_TOKEN и ~/.config/harness/env — общий с bash POSIX-код.
[ -f "$HOME/.bash_env" ] && . "$HOME/.bash_env"
