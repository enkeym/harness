# Переменные этой машины, вне git. install.sh копирует шаблон в
# ~/.config/harness/env, если файла ещё нет; ~/.bashrc и ~/.bash_env его
# подключают. Секретов сюда не класть: токены берутся из ~/.git-credentials.

# Хост GitLab (без https://), для которого ~/.bash_env достаёт GITLAB_TOKEN из
# ~/.git-credentials. Пусто — токена нет, описание MR агент отдаёт в чат.
export GITLAB_HOST=""

# Claude Code: ANTHROPIC_MODEL приоритетнее "model" в settings.json — если
# /model в какой-то сессии перезапишет settings.json на Opus, новый терминал
# всё равно стартует с Sonnet, потому что эта переменная читается раньше.
export ANTHROPIC_MODEL="sonnet"

# Каталог ragsave (venv, модели), если не ~/.rag-mcp.
# export RAGSAVE_HOME="$HOME/.rag-mcp"
