# Git-настройки этой машины, вне git. install.sh копирует шаблон в
# ~/.gitconfig.local, если файла ещё нет, и дописывает сюда настройки прежнего
# ~/.gitconfig, которых нет в общем git/gitconfig; ~/.gitconfig подключает этот
# файл через [include] последним, так что значения отсюда перекрывают общие.
# Раскомментировать и заполнить, если install не перенёс их сам.
#
# [user]
# 	name = Имя Фамилия
# 	email = you@example.com
#
# Токен GitLab открытым текстом в ~/.git-credentials (отсюда ~/.bash_env берёт
# GITLAB_TOKEN). Хелпер только для своего хоста: без адреса store сохранял бы и
# токены GitHub, которые отдаёт gh.
# [credential "https://gitlab.example.com"]
# 	helper = store
