{
  "cleanupPeriodDays": 45,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__ragsave__rag_index",
      "mcp__ragsave__rag_search",
      "mcp__ragsave__rag_status",
      "mcp__tokensave__*",
      "Bash(node ~/.ai-hooks/bin/ask-mode.mjs:*)",
      "Bash(node ~/.ai-hooks/bin/usage-report.mjs:*)",
      "mcp__playwright__*",
      "Edit(~/.ai-hooks/**)",
      "Edit(~/harness/**)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git branch --show-current)",
      "Bash(git tag -l *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh pr view *)",
      "Bash(ls *)",
      "Bash(cat /tmp/*)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(python.exe -m pytest *)",
      "Bash(sc.exe query *)",
      "Edit(//tmp/**)"
    ],
    "deny": [
      "Agent",
      "mcp__tokensave__tokensave_field_sites",
      "Bash(tokensave *install*)"
    ],
    "defaultMode": "default"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/dispatch.mjs\" PreToolUse"
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/dispatch.mjs\" PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.ai-hooks/bin/ragsave-sync.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/dispatch.mjs\" Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/dispatch.mjs\" UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/scratch.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/project-bootstrap.mjs\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/resume-hint.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.ai-hooks/bin/ragsave-sync.sh\" --warm"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.ai-hooks/claude/statusline.mjs\"",
    "refreshInterval": 5
  },
  "language": "Russian",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "showClearContextOnPlanAccept": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
