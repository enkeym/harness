{
  "cleanupPeriodDays": 45,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__ragsave__rag_index",
      "mcp__ragsave__rag_search",
      "mcp__ragsave__rag_status",
      "mcp__tokensave__*",
      "Bash(node /home/enkeym/.ai-hooks/bin/ask-mode.mjs:*)",
      "Bash(node /home/enkeym/.ai-hooks/bin/usage-report.mjs:*)",
      "mcp__playwright__*",
      "Edit(~/.ai-hooks/**)",
      "Edit(~/harness/**)"
    ],
    "deny": [
      "Agent",
      "mcp__tokensave__tokensave_field_sites"
    ],
    "defaultMode": "default"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/ask-guard.mjs"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/security-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/skill-track.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/skill-gate.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__ide__executeCode",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/bash-router.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/output-clip.mjs"
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/context-step.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|mcp__tokensave__tokensave_read|mcp__tokensave__tokensave_body|mcp__tokensave__tokensave_str_replace|mcp__tokensave__tokensave_multi_str_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/links-context.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/enkeym/.ai-hooks/bin/ragsave-sync.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/usage-log.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/bin/cleanup.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/paste-guard.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/skill-track.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/ragsave-reminder.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/ask-reminder.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/context-meter.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/ask-session.mjs"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/enkeym/.ai-hooks/claude/project-bootstrap.mjs"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "node /home/enkeym/.ai-hooks/claude/statusline.mjs",
    "refreshInterval": 5
  },
  "language": "Russian",
  "effortLevel": "high",
  "showClearContextOnPlanAccept": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false
}
