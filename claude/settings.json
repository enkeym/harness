{
  "cleanupPeriodDays": 45,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__ragsave__rag_index",
      "mcp__ragsave__rag_search",
      "mcp__ragsave__rag_status",
      "mcp__tokensave__*",
      "Bash(node ~/.ai-hooks/bin/ask-mode.mjs:*)",
      "Bash(node ~/.ai-hooks/bin/usage-report.mjs:*)",
      "mcp__playwright__*",
      "Edit(~/.ai-hooks/**)",
      "Edit(~/harness/**)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git branch --show-current)",
      "Bash(git tag -l *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh pr view *)",
      "Bash(ls *)",
      "Bash(cat /tmp/*)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(python.exe -m pytest *)",
      "Bash(sc.exe query *)",
      "Edit(//tmp/**)"
    ],
    "deny": [
      "Agent",
      "mcp__tokensave__tokensave_field_sites",
      "Bash(tokensave *install*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/ask-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/security-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/skill-track.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__tokensave__tokensave_str_replace|mcp__tokensave__tokensave_multi_str_replace|mcp__tokensave__tokensave_replace_lines|mcp__tokensave__tokensave_insert_at",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/skill-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__ide__executeCode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/bash-router.mjs\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/read-router.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__tokensave__tokensave_read|mcp__tokensave__tokensave_str_replace|mcp__tokensave__tokensave_multi_str_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/tool-args.mjs\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/plan-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/output-clip.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Grep|Bash|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-pre-tool-use"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/context-step.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|mcp__tokensave__tokensave_str_replace|mcp__tokensave__tokensave_multi_str_replace|mcp__tokensave__tokensave_replace_lines|mcp__tokensave__tokensave_insert_at|mcp__tokensave__tokensave_insert_at_symbol|mcp__tokensave__tokensave_replace_symbol",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/links-context.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-stop"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.ai-hooks/bin/ragsave-sync.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/usage-log.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/bin/cleanup.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/question-guard.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/paste-guard.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tokensave",
            "args": [
              "hook-prompt-submit"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/skill-track.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/ask-reminder.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/context-meter.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.ai-hooks/claude/project-bootstrap.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.ai-hooks/bin/ragsave-sync.sh\""
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.ai-hooks/claude/statusline.mjs\"",
    "refreshInterval": 5
  },
  "language": "Russian",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "showClearContextOnPlanAccept": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
