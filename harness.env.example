# Машинно-зависимые значения для шаблонов *.tmpl (см. bin/render.mjs).
# Здесь — значения по умолчанию, в репозитории. Свои — в harness.env рядом
# (в .gitignore): достаточно переопределить только то, что отличается.
# Переменная окружения с тем же именем важнее обоих файлов.

# Домашний каталог: пути к хукам в settings.json и правила permissions.allow
# абсолютные, $HOME в них не раскрывается.
HARNESS_USER_HOME=/home/enkeym
# Где лежит клон харнесса: правило Edit в settings.json, скилл doctor.
HARNESS_DIR=${HARNESS_USER_HOME}/harness

# Бинари
HARNESS_TOKENSAVE_BIN=/usr/local/bin/tokensave
HARNESS_GH_BIN=/usr/bin/gh
HARNESS_PLAYWRIGHT_MCP_BIN=${HARNESS_USER_HOME}/.nvm/versions/node/v24.18.0/bin/playwright-mcp
HARNESS_PNPM_HOME=${HARNESS_USER_HOME}/.local/share/pnpm

# git: identity в ~/.gitconfig и хост GitLab, для которого ~/.bash_env
# достаёт GITLAB_TOKEN из ~/.git-credentials.
HARNESS_GIT_NAME=Enkeym
HARNESS_GIT_EMAIL=nikita.korolev96@outlook.com
HARNESS_GITLAB_HOST=git.stormapi.su

# Claude Code: модель (default — выбор по аккаунту), effort и тема в settings.json.
HARNESS_CLAUDE_MODEL=default
HARNESS_CLAUDE_EFFORT=high
HARNESS_CLAUDE_THEME=dark-ansi

# Цели install.sh, которые машина держит своими (пути от $HOME через пробел):
# не симлинкуются и не проверяются, например `.gitconfig .bashrc`.
HARNESS_SKIP_LINKS=
